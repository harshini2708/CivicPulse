rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }

    function isUnderMaxSize() {
      return request.resource.size < 5 * 1024 * 1024; // 5 MB limit
    }

    // Citizen original issue photos
    match /complaints/{complaintId}/{allPaths=**} {
      allow read: if true;
      allow write: if isImage() && isUnderMaxSize();
    }

    // Field worker repair evidence photos
    match /evidence/{complaintId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isImage() && isUnderMaxSize();
    }
  }
}
