# ===========================
# Frontend .gitignore
# ===========================

# Environment files — NEVER commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build output
dist/
dist-ssr/
build/

# Vite cache
.vite/

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Testing
coverage/
